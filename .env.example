# Alibaba Cloud Model Studio (Bailian) — get key at https://bailian.console.aliyun.com (or modelstudio.console.alibabacloud.com)
DASHSCOPE_API_KEY=your_api_key_here
# Optional: region-specific base URL override (leave blank to auto-select Singapore intl)
QWEN_BASE_URL=
# Optional: workspace-dedicated domain (recommended for production)
QWEN_WORKSPACE_ID=
QWEN_REGION=ap-southeast-1
ATLAS_CLIENT_ID=your_atlas_client_id_here
ATLAS_CLIENT_SECRET=your_atlas_client_secret_here
ATLAS_BASE_URL=https://sandbox.atriptech.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DISCORD_BOT_TOKEN=your_discord_bot_token
